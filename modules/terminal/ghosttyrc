command                 = /run/current-system/sw/bin/nu
font-family             = Iosevka Term
font-feature            = -calt
font-feature            = -liga
font-feature            = -dlig
theme                   = GruvboxDark
window-decoration       = false
window-padding-balance  = true
window-padding-color    = extend
mouse-hide-while-typing = true
keybind                 = shift+enter=text:\n
